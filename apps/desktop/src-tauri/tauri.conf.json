{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBazaar",
  "version": "0.1.0-alpha.1",
  "identifier": "app.openbazaar.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build --prefix ../mobile",
    "frontendDist": "../../mobile/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ob-node"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
