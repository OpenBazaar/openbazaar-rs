{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBazaar",
  "version": "0.0.0",
  "identifier": "app.openbazaar.desktop",
  "build": {
    "beforeBuildCommand": "npm run build --prefix ../mobile",
    "frontendDist": "../../mobile/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBazaar",
        "width": 960,
        "height": 720,
        "resizable": true,
        "backgroundColor": "#063853"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
